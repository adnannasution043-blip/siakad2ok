# ── Database ──────────────────────────────────────────────────────────────────
# Railway akan set ini otomatis saat kamu tambah plugin PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=ganti-dengan-random-string-minimal-64-karakter
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
